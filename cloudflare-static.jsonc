{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haolin-website",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "assets": {
    "directory": "./dist/client",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
